# Publish only the two stereo algorithms and their supporting artifacts.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements.txt
!/src/
!/tests/
!/docs/
!/results/
!/uav_stereo_incremental_visual_graph_global_registration.py
!/UAV_Binocular_Camera_block_incremental_rigid_stereo_similarity_backbone_core.py

# Generated Python and test artifacts
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Local input images, experiments, environments, and editor state stay private.
**/*.egg-info/
**/.ruff_cache/
**/.DS_Store
**/Thumbs.db
